# Copy to .env and fill in locally:  cp .env.example .env
# .env is git-ignored. Never commit real keys or paste them into chat.

# Cursor API key (https://cursor.com/dashboard/integrations)
CURSOR_API_KEY=your-cursor-api-key

# Model ID available to your account. List them with:
#   python -m generic_agent --list-models
CURSOR_MODEL=your-cursor-model-id

# --- Optional, Studio only (not needed for the CLI or tests) ---
# LangSmith key, only if you want tracing from `langgraph dev`.
# LANGSMITH_API_KEY=your-langsmith-api-key

# --- INIT agent (python -m init_agent, POST /api/init) ---
# Repository to analyze (public clone URL). A request may override it.
REPO_URL=https://github.com/shira-ozana/angular-realworld-example-app
REPO_BASE_REF=main
# Branch INIT creates (or continues) and pushes; output goes under platform/.
INIT_BRANCH=shipAI
# Token with write access to REPO_URL (or to PUSH_URL). Needed only to push.
GIT_TOKEN=your-github-token
# Optional: push somewhere else than REPO_URL (for example a fork).
# PUSH_URL=
# INIT_PUSH=true
# INIT_WORKSPACE_DIR=./workspaces
# Optional tuning
# INIT_CONTEXT_BUDGET_CHARS=60000
# INIT_MAX_COMPONENTS=25
# INIT_LLM_CONCURRENCY=2
# Optional: folder with extra/override rules, guidelines and skills
# INIT_PROMPTS_DIR=
