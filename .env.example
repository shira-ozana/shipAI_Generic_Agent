# Copy to .env and fill in locally:  cp .env.example .env
# .env is git-ignored. Never commit real keys or paste them into chat.

# Cursor API key (https://cursor.com/dashboard/integrations)
CURSOR_API_KEY=your-cursor-api-key

# Model ID available to your account. List them with:
#   python -m generic_agent --list-models
CURSOR_MODEL=your-cursor-model-id

# --- Optional, Studio only (not needed for the CLI or tests) ---
# LangSmith key, only if you want tracing from `langgraph dev`.
# LANGSMITH_API_KEY=your-langsmith-api-key

# --- Optional, Task Split review/approval API (/api/task-plans) ---
# Repositories the Task Split agent may read (read-only checkouts of the revision to
# plan against). Clients pick one by ID and never send paths or credentials.
# JSON: {"<id>": {"path": "/abs/checkout", "revision": "<sha>", "allowed_paths": ["src"]}}
# TASK_SPLIT_REPOSITORIES={"shop": {"path": "/abs/path/to/shop-checkout"}}
# SQLite file for drafts and approved tasks (default ./task_plans.sqlite3)
# TASK_SPLIT_DB=task_plans.sqlite3
