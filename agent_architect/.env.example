# Cursor (used by the generic agent). List models: python -m generic_agent --list-models
CURSOR_API_KEY=your-cursor-api-key
CURSOR_MODEL=your-model-id

# Same Supabase project and encryption key as sdlc/backend/.env
# (the agent reads the GitHub credentials that the backend saved).
SUPABASE_URL=https://oecdzywomnbojbmgnclp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ENCRYPTION_KEY=your-encryption-key-from-backend-env

# Branch of the project repository the Requirement Agent works on (and the
# architect clones and pushes to). Same as the Requirement Agent: ShipAi.
ARCHITECT_SOURCE_BRANCH=ShipAi
# Optional: push to a different branch than ARCHITECT_SOURCE_BRANCH.
ARCHITECT_TARGET_BRANCH=

# Optional: author of the commits the agent pushes.
GIT_AUTHOR_NAME=SDLC Architect Agent
GIT_AUTHOR_EMAIL=architect-agent@sdlc.local
